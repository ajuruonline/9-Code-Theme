{
  "apiVersion": 3,
  "name": "ninecm/post-of-contents",
  "version": "4.0.0",
  "title": "9 Post of Contents",
  "category": "widgets",
  "icon": "networking",
  "description": "Text-only taxonomy terms and content items with hierarchy when available, plus optional search, filter and dropdowns.",
  "textdomain": "nine-category-manager",
  "editorScript": "ninecm-block-editor",
  "viewScript": "ninecm-frontend",
  "style": "ninecm-frontend",
  "attributes": {
    "taxonomy": {"type":"string","default":"category"},
    "root": {"type":"number","default":0},
    "depth": {"type":"number","default":0},
    "hideEmpty": {"type":"boolean","default":true},
    "collapsible": {"type":"boolean","default":true},
    "initiallyOpen": {"type":"boolean","default":true},
    "marker": {"type":"string","default":"number"},
    "icon": {"type":"string","default":"›"},
    "showSearch": {"type":"boolean","default":true},
    "showFilter": {"type":"boolean","default":true},
    "style": {"type":"string","default":"clean"},
    "postTypes": {"type":"array","default":["page","post"]},
    "postsPerCategory": {"type":"number","default":0},
    "showCounts": {"type":"boolean","default":false},
    "deduplicate": {"type":"boolean","default":false},
    "termOrderby": {"type":"string","default":"name"},
    "termOrder": {"type":"string","default":"ASC"},
    "postOrderby": {"type":"string","default":"title"},
    "postOrder": {"type":"string","default":"ASC"},
    "emptyMessage": {"type":"string","default":"No matching content found."}
  },
  "supports": {"html": false, "align": ["wide","full"]}
}
