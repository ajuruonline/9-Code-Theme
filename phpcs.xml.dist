<?xml version="1.0"?>
<ruleset name="Nine Code audit">
	<description>Security, i18n, deprecation and PHP-compatibility checks for the theme and the plugin.</description>
	<file>theme</file>
	<file>plugin</file>
	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<!-- Brace-less foreach { ...; break; } is valid; the sniff mis-reads it. php -l covers real cases. -->
	<rule ref="PHPCompatibility.ControlStructures.ForbiddenBreakContinueOutsideLoop"><severity>0</severity></rule>

	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array"><element value="nine-code"/><element value="nine-code-data"/></property></properties>
	</rule>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.Security.EscapeOutput"/>
	<config name="minimum_wp_version" value="6.6"/>
</ruleset>
