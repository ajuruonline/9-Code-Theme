{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1180px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "open-scholar", "name": "Open Scholar Green", "color": "#14532d" },
        { "slug": "open-scholar-dark", "name": "Open Scholar Dark", "color": "#123d2a" },
        { "slug": "text", "name": "Text", "color": "#191919" },
        { "slug": "muted", "name": "Muted", "color": "#5e5e5e" },
        { "slug": "line", "name": "Line", "color": "#e0dfdc" },
        { "slug": "soft", "name": "Soft Green", "color": "#e5f2eb" },
        { "slug": "page", "name": "Page", "color": "#f2f5f3" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": { "units": ["px", "rem", "em", "%", "vh", "vw"] },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "System Sans", "fontFamily": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif" },
        { "slug": "serif", "name": "Editorial Serif", "fontFamily": "Georgia,Cambria,Times New Roman,serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#f2f5f3", "text": "#191919" },
    "typography": { "fontFamily": "var:preset|font-family|system", "lineHeight": "1.65" },
    "elements": {
      "link": { "color": { "text": "#14532d" } },
      "button": { "color": { "background": "#14532d", "text": "#ffffff" }, "border": { "radius": "4px" }, "typography": { "fontWeight": "700" } },
      "heading": { "typography": { "lineHeight": "1.15", "fontWeight": "750" } }
    },
    "blocks": {
      "core/code": { "color": { "background": "#123d2a", "text": "#ffffff" }, "border": { "radius": "8px" } },
      "core/quote": { "border": { "color": "#14532d", "width": "0 0 0 4px" }, "spacing": { "padding": { "left": "1.25rem" } } }
    }
  }
}
