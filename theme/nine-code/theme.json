{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1180px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "black", "name": "9code Black", "color": "#000000" },
        { "slug": "charcoal", "name": "Charcoal", "color": "#202124" },
        { "slug": "muted", "name": "Muted", "color": "#5f6368" },
        { "slug": "line", "name": "Line", "color": "#e5e7eb" },
        { "slug": "soft", "name": "Soft", "color": "#f6f7f8" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": { "units": ["px", "rem", "em", "%", "vh", "vw"] },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "System Sans", "fontFamily": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif" },
        { "slug": "serif", "name": "Editorial Serif", "fontFamily": "Georgia,Cambria,Times New Roman,serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#ffffff", "text": "#000000" },
    "typography": { "fontFamily": "var:preset|font-family|system", "lineHeight": "1.65" },
    "elements": {
      "link": { "color": { "text": "#000000" } },
      "button": { "color": { "background": "#000000", "text": "#ffffff" }, "border": { "radius": "10px" }, "typography": { "fontWeight": "700" } },
      "heading": { "typography": { "lineHeight": "1.15", "fontWeight": "750" } }
    },
    "blocks": {
      "core/code": { "color": { "background": "#111111", "text": "#ffffff" }, "border": { "radius": "10px" } },
      "core/quote": { "border": { "color": "#000000", "width": "0 0 0 4px" }, "spacing": { "padding": { "left": "1.25rem" } } }
    }
  }
}
