{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://9code.local/contracts/9block-v1.schema.json",
  "title": "9Code 9Block Manifest v1",
  "type": "object",
  "required": [
    "slug",
    "name",
    "runtime"
  ],
  "properties": {
    "format": {
      "const": "9block"
    },
    "format_version": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "job": {
      "type": "string",
      "maxLength": 240
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "runtime": {
      "enum": [
        "declarative",
        "engine"
      ]
    },
    "engine": {
      "type": "string",
      "pattern": "^[a-z0-9_-]*$"
    },
    "template": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "textarea",
              "richtext",
              "url",
              "number",
              "boolean",
              "select"
            ]
          },
          "default": {},
          "options": {
            "type": "array",
            "maxItems": 50
          }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string"
      }
    },
    "semantic_role": {
      "enum": [
        "content",
        "action",
        "media",
        "navigation",
        "layout"
      ],
      "default": "content"
    },
    "host_navigation": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "engine"
          }
        }
      },
      "then": {
        "required": [
          "engine"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "declarative"
          }
        }
      },
      "then": {
        "required": [
          "template"
        ]
      }
    }
  ],
  "additionalProperties": true
}
