{
  "name": "Open Scholar Secure Player",
  "short_name": "OS Player",
  "description": "Open lessons, PDFs and videos simply, and protect files when you need to control who sees them. Powered by OpenScholar.ng.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#00532d",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon.svg", "sizes": "any", "type": "image/svg+xml"}
  ]
}
