{
  "name": "open-scholar-theme",
  "private": true,
  "description": "Open Scholar Theme: lean WordPress host, integration contract, tooling and tests",
  "scripts": {
    "lint": "bin/lint.sh",
    "build": "bin/build.sh",
    "site:setup": "bin/setup-test-site.sh && bin/serve-test-site.sh",
    "test:public": "node tests/e2e/public.mjs",
    "test:crawl": "node tests/e2e/crawl.mjs",
    "test:editor": "node tests/e2e/editor.mjs",
    "test:upgrade": "bin/test-upgrade.sh",
    "test": "npm run lint && node tests/e2e/public.mjs && node tests/e2e/crawl.mjs && node tests/e2e/editor.mjs && node tests/e2e/visual-editor.mjs",
    "test:visual": "node tests/e2e/visual-editor.mjs",
    "test:legacy-data-manager": "tests/integration/run.sh && node tests/e2e/data-workspace.mjs && bin/plugin-check.sh",
    "audit": "bin/audit.sh",
    "test:integration": "tests/integration/run.sh",
    "test:workspace": "node tests/e2e/data-workspace.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
